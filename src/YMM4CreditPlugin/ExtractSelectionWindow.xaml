<Window x:Class="YMM4CreditPlugin.ExtractSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="追加する素材を選択" Width="720" Height="480" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="GridStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="全選択" Click="SelectAll_Click" Padding="8,2" Margin="0,0,8,0" />
                <Button Content="全解除" Click="UnselectAll_Click" Padding="8,2" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="追加" Click="Ok_Click" IsDefault="True" Padding="16,2" Margin="0,0,8,0" />
                <Button Content="キャンセル" IsCancel="True" Padding="8,2" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="チェックした素材だけリストに追加します(登録済みの素材は表示していません)" Margin="0,0,0,4" />
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <!-- DataGridCheckBoxColumn は「行を選択→クリック」の 2 回操作になるため、テンプレートで常にクリックできるチェックボックスを置く -->
                <DataGridTemplateColumn Header="追加" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="種類" Binding="{Binding KindName}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="素材名" Binding="{Binding Material.DefaultName}" IsReadOnly="True" Width="160" />
                <DataGridTextColumn Header="ファイル・キー" Binding="{Binding Material.Key}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
